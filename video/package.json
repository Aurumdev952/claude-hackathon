{
  "name": "early-signals-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Early Signals data videos: Remotion compositions (patient case summary, ministry reel) and a Hono render server",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/copy-assets.mjs",
    "assets": "node scripts/copy-assets.mjs",
    "studio": "remotion studio src/index.ts --port 3010 --browser-executable=$BROWSER_EXECUTABLE",
    "serve": "tsx src/server.ts",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "render": "tsx scripts/render.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/urbanist": "5.3.0",
    "@hono/node-server": "2.1.3",
    "@react-three/fiber": "8.18.0",
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/player": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@remotion/three": "4.0.532",
    "hono": "4.13.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.532",
    "three": "0.170.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "18.3.31",
    "@types/three": "0.170.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
