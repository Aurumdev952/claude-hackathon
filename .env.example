# Copy to .env (cp .env.example .env). The Makefile includes this file, so keep values plain:
# no quotes, no spaces around "=", comments on their own lines only.

# MySQL (scripts/setup_ubuntu.sh creates MYSQL_USER with this password; the loader creates the read-only ETL user)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=es_admin
MYSQL_ROOT_PASSWORD=change_me
MYSQL_ETL_USER=etl
MYSQL_ETL_PASSWORD=change_me

# Dataset: scale 1.0 = 1.5M people, the scale every result in README/SETUP.md was verified at
SCALE=1.0
SEED=42

# Live loop: one simulator tick and one pipeline batch every TICK_SECONDS; each tick replays SIM_DAYS_PER_TICK days
TICK_SECONDS=300
SIM_DAYS_PER_TICK=1
DEMO_MODE=false

# AI provider: template (default, no model needed) | ollama | anthropic
LLM_PROVIDER=template
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=

API_CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data
CONFIG_DIR=./config

# AI agent (agent/, Hono on :8787). OpenRouter by default; AGENT_PROVIDER=openai-compatible + AGENT_BASE_URL for a government endpoint
OPENROUTER_API_KEY=
AGENT_MODEL=deepseek/deepseek-v4.1-flash
AGENT_PROVIDER=openrouter
AGENT_BASE_URL=
AGENT_PORT=8787
AGENT_URL=http://localhost:8787
AGENT_DB_PATH=agent/data/agent.sqlite
AGENT_ARTIFACTS_DIR=agent/data/artifacts
SANDBOX_TIMEOUT_S=30
SANDBOX_MEM_MB=2048
EVAL_JUDGE_MODEL=deepseek/deepseek-v4-pro

# Data videos (video/, Remotion render server on :8790; output cached 14 days in data/videos)
VIDEO_PORT=8790
# VIDEO_API_URL=http://127.0.0.1:8000/api/v1   # FastAPI the props builder calls (default: API_URL + /api/v1, else :8000)
# VIDEO_GL=swangle           # force one Chromium GL backend (default: swangle for the 3D patient video, Chromium default otherwise)
# VIDEO_3D=off               # always use the 2D body instead of the 3D turntable
# VIDEO_CONCURRENCY=3
