{
  "name": "early-signals-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Early Signals AI agent: Hono + Vercel AI SDK 7 backend, MCP server and Python sandbox over the published DuckDB marts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:fixture": "tsx test/fixtures/build-duck.ts",
    "db:generate": "drizzle-kit generate",
    "spike": "tsx scripts/spike.ts",
    "smoke": "tsx scripts/smoke.ts",
    "mcp:check": "tsx scripts/mcp-check.ts",
    "sandbox:setup": "uv sync --project sandbox"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.62",
    "@duckdb/node-api": "1.5.6-r.1",
    "@hono/mcp": "0.3.2",
    "@hono/node-server": "2.1.3",
    "@libsql/client": "0.18.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.126",
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
